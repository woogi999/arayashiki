{
  "name": "arayashiki",
  "version": "1.0.1",
  "private": true,
  "description": "Jujutsu Shenanigans' Skill Builder as a desktop app: open a moveset's code, edit it node by node, simulate skills on a 3D character, copy the code back. Its engine also answers AI agents through a CLI and an MCP server.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#codec": {
      "node": "./core/codec-node.js",
      "default": "./core/codec-web.js"
    }
  },
  "exports": {
    ".": "./core/index.js",
    "./agent": "./agent/tools.js"
  },
  "bin": {
    "sbs": "./agent/cli.js",
    "arayashiki-mcp": "./agent/mcp-server.js"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "vite build",
    "test": "node --test \"tests/**/*.test.js\"",
    "mcp": "node agent/mcp-server.js",
    "sbs": "node agent/cli.js",
    "library": "node lib/build-jjs-library.mjs",
    "game-data": "node lib/extract-jjs-game.mjs",
    "fx-data": "node lib/extract-jjs-fx.mjs",
    "format": "prettier . --cache --write"
  },
  "engines": {
    "node": ">= 22.15.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@preact/signals": "^2.11.2",
    "@tauri-apps/api": "^2.12.0",
    "cannon-es": "^0.20.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "lucide-preact": "^1.48.0",
    "mediabunny": "^1.61.0",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  }
}
